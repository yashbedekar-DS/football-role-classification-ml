# ═══════════════════════════════════════════════════════════════
# PART A — TRANSFER LEARNING  (MobileNetV2 + ResNet50)
# ═══════════════════════════════════════════════════════════════

def build_mobilenet():
    base = MobileNetV2(weights='imagenet', include_top=False,
                       input_shape=(224, 224, 3))
    base.trainable = False
    inp = keras.Input(shape=(224, 224, 3))
    x   = base(inp, training=False)
    x   = layers.GlobalAveragePooling2D()(x)
    x   = layers.Dense(256, activation='relu',
                       kernel_regularizer=regularizers.l2(1e-4))(x)
    x   = layers.Dropout(0.40)(x)
    out = layers.Dense(NUM_CLASSES, activation='softmax')(x)
    model = keras.Model(inp, out, name='MobileNetV2')
    model.compile(optimizer=Adam(LR), loss=LOSS_FN, metrics=['accuracy'])
    return model, base


def build_resnet():
    base = ResNet50(weights='imagenet', include_top=False,
                    input_shape=(224, 224, 3))
    base.trainable = False
    inp = keras.Input(shape=(224, 224, 3))
    x   = base(inp, training=False)
    x   = layers.GlobalAveragePooling2D()(x)
    x   = layers.Dense(512, activation='relu',
                       kernel_regularizer=regularizers.l2(1e-4))(x)
    x   = layers.Dropout(0.50)(x)
    out = layers.Dense(NUM_CLASSES, activation='softmax')(x)
    model = keras.Model(inp, out, name='ResNet50')
    model.compile(optimizer=Adam(LR), loss=LOSS_FN, metrics=['accuracy'])
    return model, base


def train_transfer_model(name, model, base):
    print("\n" + "="*60)
    print(f"🚀 TRAINING {name}")
    print("="*60)
    t0 = time.time()

    # Phase 1: frozen backbone
    print("\n📌 Phase 1 — Frozen backbone")
    h1 = model.fit(train_gen, validation_data=val_gen,
                   epochs=EPOCHS_TL, callbacks=get_callbacks(name + '_p1'), verbose=1)

    # Phase 2: unfreeze top-30 layers for fine-tuning
    print("\n📌 Phase 2 — Fine-tuning top-30 layers")
    base.trainable = True
    for layer in base.layers[:-30]:
        layer.trainable = False
    model.compile(optimizer=Adam(FINE_LR), loss=LOSS_FN, metrics=['accuracy'])
    h2 = model.fit(train_gen, validation_data=val_gen,
                   epochs=EPOCHS_TL, callbacks=get_callbacks(name + '_p2'), verbose=1)

    elapsed = time.time() - t0

    # Merge histories
    merged = {k: h1.history[k] + h2.history[k] for k in h1.history}
    all_histories[name] = merged
    all_times[name]     = elapsed
    pd.DataFrame(merged).to_csv(f'results/tables/{name}_history.csv', index=False)

    print(f"\n✅ {name} done in {elapsed/60:.2f} min")
    print(f"📈 Best Val Accuracy: {max(merged['val_accuracy'])*100:.2f}%")
    return model


mob_model, mob_base = build_mobilenet()
mob_model = train_transfer_model('MobileNetV2', mob_model, mob_base)

res_model, res_base = build_resnet()
res_model = train_transfer_model('ResNet50', res_model, res_base)

