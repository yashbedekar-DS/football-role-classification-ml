# ── Figure 7: SHAP explanations ──────────────────────────────────────────────
def run_shap_analysis(model, model_name, n_bg=40, n_explain=4):
    """SHAP GradientExplainer — per-class attribution maps."""

    # ── 1. Build background from training set ────────────────────────────────
    train_gen.reset()
    bg = []
    for imgs, _ in train_gen:
        bg.append(imgs)
        if sum(x.shape[0] for x in bg) >= n_bg:
            break
    background = np.vstack(bg)[:n_bg]

    # ── 2. Collect test images ───────────────────────────────────────────────
    test_gen.reset()
    te_imgs, te_lbls = [], []
    for imgs, lbls in test_gen:
        te_imgs.append(imgs)
        te_lbls.append(lbls)
        if sum(x.shape[0] for x in te_imgs) >= n_explain:
            break
    te_imgs = np.vstack(te_imgs)[:n_explain]
    te_lbls = np.vstack(te_lbls)[:n_explain]

    print(f"Computing SHAP for {model_name} ({n_explain} images, {n_bg} background)...")

    # ── 3. Run SHAP ──────────────────────────────────────────────────────────
    explainer   = shap.GradientExplainer(model, background)
    shap_values = explainer.shap_values(te_imgs)   # may be list OR ndarray

    # Normalise to a single ndarray: (n_explain, H, W, C, n_classes)
    # GradientExplainer returns EITHER:
    #   • list of n_classes arrays each (n_explain, H, W, C)  — older SHAP/TF
    #   • single ndarray (n_explain, H, W, C, n_classes)      — newer SHAP/Keras-3
    if isinstance(shap_values, list):
        # stack list → (n_explain, H, W, C, n_classes)
        sv_array = np.stack(shap_values, axis=-1)   # each item: (n,H,W,C)
    elif isinstance(shap_values, np.ndarray):
        if shap_values.ndim == 4:
            # shape (n_classes, n_explain, H, W) — some SHAP versions
            # transpose → (n_explain, H, W, n_classes) then expand C dim
            sv_array = np.transpose(shap_values, (1, 2, 3, 0))[:, :, :, np.newaxis, :]
        else:
            # already (n_explain, H, W, C, n_classes)
            sv_array = shap_values
    else:
        raise ValueError(f"Unexpected shap_values type: {type(shap_values)}")

    # ── 4. Plot ──────────────────────────────────────────────────────────────
    fig, axes = plt.subplots(
        n_explain, NUM_CLASSES + 1,
        figsize=(3.5 * (NUM_CLASSES + 1), 3.5 * n_explain)
    )
    fig.patch.set_facecolor('#0D1117')
    fig.suptitle(
        f'Figure 7 — SHAP Explanations: {model_name}',
        color='white', fontsize=13, fontweight='bold', y=1.01
    )

    axes[0, 0].set_title('Input', color='white', fontsize=10, fontweight='bold')
    for ci, cn in enumerate(CLASS_NAMES):
        axes[0, ci + 1].set_title(
            cn,
            color=ROLE_COLORS.get(cn, 'white'),
            fontsize=10, fontweight='bold'
        )

    for row in range(n_explain):
        true_cls = np.argmax(te_lbls[row])
        pred_cls = np.argmax(model.predict(te_imgs[row:row + 1], verbose=0))

        # --- input column ---
        axes[row, 0].imshow(te_imgs[row])
        axes[row, 0].set_ylabel(
            f"True: {CLASS_NAMES[true_cls]}\nPred: {CLASS_NAMES[pred_cls]}",
            color=ROLE_COLORS.get(CLASS_NAMES[true_cls], 'white'),
            fontsize=8, fontweight='bold'
        )
        axes[row, 0].tick_params(
            left=False, bottom=False, labelleft=False, labelbottom=False
        )
        axes[row, 0].set_facecolor('#161B22')

        # --- per-class SHAP columns ---
        for ci in range(NUM_CLASSES):
            # sv_array shape: (n_explain, H, W, C, n_classes)
            sv = sv_array[row, :, :, :, ci]          # (H, W, C)
            sv_map = np.mean(np.abs(sv), axis=-1)     # collapse channels → (H, W)
            sv_map = (sv_map - sv_map.min()) / (sv_map.max() - sv_map.min() + 1e-8)

            axes[row, ci + 1].imshow(te_imgs[row], alpha=0.4)
            axes[row, ci + 1].imshow(
                sv_map, cmap='RdBu_r', alpha=0.65, vmin=0, vmax=1
            )
            axes[row, ci + 1].axis('off')
            axes[row, ci + 1].set_facecolor('#161B22')

    plt.tight_layout()
    safe = model_name.replace(' ', '_').lower()
    plt.savefig(
        f'results/figures/fig7_shap_{safe}.png',
        dpi=120, bbox_inches='tight', facecolor=fig.get_facecolor()
    )
    plt.show()
    print(f"✅ SHAP saved for {model_name}")


# ── Run for all three models ──────────────────────────────────────────────────
for mname, mobj in [
    ('Custom CNN',  cnn_model),
    ('MobileNetV2', mob_model),
    ('ResNet50',    res_model),
]:
    try:
        run_shap_analysis(mobj, mname)
    except Exception as e:
        print(f"⚠  SHAP error for {mname}: {e}")


